{
  "$description": "Meadow: an example profile for consumer apps. Violet brand, Fraunces headings over Nunito text, pill-shaped controls and soft cards. Overrides only brand roles, typefaces and shape.",
  "typeface": {
    "display": { "$value": "{font.family.fraunces}" },
    "text": { "$value": "{font.family.nunito}" }
  },
  "action": {
    "primary": {
      "background": { "$value": "{brand.meadow.strong}" },
      "hover": { "$value": "{brand.meadow.stronger}" },
      "active": { "$value": "{brand.meadow.strongest}" },
      "foreground": { "$value": "{brand.meadow.on-strong}" },
      "border": { "$value": "{brand.meadow.strong}" }
    }
  },
  "text": {
    "link": { "$value": "{brand.meadow.text}" }
  },
  "focus": {
    "ring": { "$value": "{brand.meadow.border}" }
  },
  "surface": {
    "accent": { "$value": "{brand.meadow.subtle}" }
  },
  "signal": {
    "current": { "$value": "{brand.meadow.border}" },
    "glow": { "$value": "{brand.meadow.glow}" }
  },
  "tone": {
    "brand": {
      "text": { "$value": "{brand.meadow.text}" },
      "surface": { "$value": "{brand.meadow.subtle}" },
      "border": { "$value": "{brand.meadow.border}" },
      "solid": { "$value": "{brand.meadow.strong}" },
      "on-solid": { "$value": "{brand.meadow.on-strong}" }
    }
  },
  "control": {
    "radius": { "$value": "{radius.full}" }
  },
  "badge": {
    "radius": { "$value": "{radius.full}" }
  },
  "card": {
    "radius": { "$value": "{radius.xl}" }
  },
  "dialog": {
    "radius": { "$value": "{radius.xl}" }
  },
  "radio-group": {
    "card-radius": { "$value": "{radius.lg}" }
  }
}
