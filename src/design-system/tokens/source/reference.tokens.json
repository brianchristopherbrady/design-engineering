{
  "$description": "Reference tokens: raw scales and palettes with no intent attached. Components never read these colors directly.",
  "color": {
    "$type": "color",
    "neutral": {
      "$description": "Cool gray ramp for text, surfaces and borders in both themes.",
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9686, 0.9765], "hex": "#f6f7f9" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9255, 0.9373, 0.9529], "hex": "#eceff3" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.8667, 0.8824, 0.9098], "hex": "#dde1e8" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.7647, 0.7882, 0.8314], "hex": "#c3c9d4" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.5804, 0.6157, 0.6863], "hex": "#949daf" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.4235, 0.4588, 0.5373], "hex": "#6c7589" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.3255, 0.3569, 0.4275], "hex": "#535b6d" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.2667, 0.3294], "hex": "#3d4454" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.1882, 0.2392], "hex": "#2a303d" } },
      "850": { "$value": { "colorSpace": "srgb", "components": [0.1216, 0.1451, 0.1922], "hex": "#1f2531" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.0902, 0.1098, 0.149], "hex": "#171c26" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "hex": "#0f131b" } }
    },
    "blue": {
      "$description": "Brand and interaction hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9529, 1], "hex": "#eef3ff" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.8627, 0.902, 1], "hex": "#dce6ff" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.7373, 0.8118, 1], "hex": "#bccfff" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.5765, 0.6902, 1], "hex": "#93b0ff" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.4157, 0.5608, 0.9765], "hex": "#6a8ff9" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.2902, 0.4353, 0.9412], "hex": "#4a6ff0" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.2078, 0.3412, 0.8471], "hex": "#3557d8" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.2706, 0.7098], "hex": "#2a45b5" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.2353, 0.5686], "hex": "#263c91" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.1294, 0.1961, 0.4392], "hex": "#213270" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.1216, 0.2706], "hex": "#161f45" } }
    },
    "green": {
      "$description": "Success hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9294, 0.9843, 0.9529], "hex": "#edfbf3" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.4902, 0.851, 0.6588], "hex": "#7dd9a8" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.1843, 0.651, 0.4157], "hex": "#2fa66a" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.5412, 0.3216], "hex": "#1e8a52" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0941, 0.4392, 0.2627], "hex": "#187043" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0824, 0.3529, 0.2196], "hex": "#155a38" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.1647, 0.1059], "hex": "#0a2a1b" } }
    },
    "red": {
      "$description": "Danger hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9451, 0.9412], "hex": "#fff1f0" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.8706, 0.8588], "hex": "#ffdedb" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [1, 0.7529, 0.7294], "hex": "#ffc0ba" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [1, 0.6196, 0.5882], "hex": "#ff9e96" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.4549, 0.4157], "hex": "#f8746a" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.8118, 0.2275, 0.1843], "hex": "#cf3a2f" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.6784, 0.1725, 0.1373], "hex": "#ad2c23" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.5529, 0.149, 0.1255], "hex": "#8d2620" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.4353, 0.1294, 0.1098], "hex": "#6f211c" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.0588, 0.0471], "hex": "#3d0f0c" } }
    },
    "amber": {
      "$description": "Warning hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9725, 0.902], "hex": "#fff8e6" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.7725, 0.3529], "hex": "#f8c55a" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.8314, 0.5412, 0.0627], "hex": "#d48a10" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.7098, 0.4275, 0.0275], "hex": "#b56d07" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.4549, 0.2667, 0.0471], "hex": "#74440c" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.1137, 0.0196], "hex": "#331d05" } }
    },
    "cyan": {
      "$description": "Informational hue, kept distinct from the brand blue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9216, 0.9804, 0.9922], "hex": "#ebfafd" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.4039, 0.8118, 0.902], "hex": "#67cfe6" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.7059, 0.8157], "hex": "#33b4d0" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.0549, 0.4824, 0.5765], "hex": "#0e7b93" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.051, 0.3922, 0.4706], "hex": "#0d6478" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.3176, 0.3804], "hex": "#0f5161" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0275, 0.1647, 0.2], "hex": "#072a33" } }
    },
    "transparent": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 },
      "$description": "Invisible fill or border that still occupies space and becomes visible in forced-colors mode."
    },
    "scrim": {
      "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.55 },
      "$description": "Translucent neutral used behind modal dialogs."
    },
    "scrim-deep": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.7 },
      "$description": "Darker scrim for dark surfaces, where a lighter scrim would not separate layers."
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale. Semantic spacing tokens give these steps the names components use.",
    "2xs": { "$value": { "value": 0.25, "unit": "rem" } },
    "xs": { "$value": { "value": 0.5, "unit": "rem" } },
    "sm": { "$value": { "value": 0.75, "unit": "rem" } },
    "md": { "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$value": { "value": 1.5, "unit": "rem" } },
    "xl": { "$value": { "value": 2, "unit": "rem" } },
    "2xl": { "$value": { "value": 3, "unit": "rem" } },
    "3xl": { "$value": { "value": 4, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Control heights. md is 44px at the default text size.",
      "sm": { "$value": { "value": 2, "unit": "rem" } },
      "md": { "$value": { "value": 2.75, "unit": "rem" } },
      "lg": { "$value": { "value": 3.25, "unit": "rem" } }
    },
    "badge": {
      "sm": { "$value": { "value": 1.25, "unit": "rem" } },
      "md": { "$value": { "value": 1.5, "unit": "rem" } },
      "lg": { "$value": { "value": 2, "unit": "rem" } }
    },
    "icon": {
      "sm": { "$value": { "value": 1, "unit": "rem" } },
      "md": { "$value": { "value": 1.25, "unit": "rem" } },
      "lg": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "item": {
      "$description": "Minimum track sizes for intrinsic Grid layouts.",
      "xs": { "$value": { "value": 10, "unit": "rem" } },
      "sm": { "$value": { "value": 14, "unit": "rem" } },
      "md": { "$value": { "value": 18, "unit": "rem" } },
      "lg": { "$value": { "value": 24, "unit": "rem" } }
    },
    "dialog": {
      "$description": "Maximum dialog widths; dialogs never exceed the viewport.",
      "sm": { "$value": { "value": 24, "unit": "rem" } },
      "md": { "$value": { "value": 32, "unit": "rem" } },
      "lg": { "$value": { "value": 44, "unit": "rem" } }
    },
    "container": {
      "$description": "Maximum inline sizes for Container.",
      "narrow": { "$value": { "value": 48, "unit": "rem" } },
      "default": { "$value": { "value": 72, "unit": "rem" } },
      "wide": { "$value": { "value": 90, "unit": "rem" } }
    },
    "measure": {
      "$value": { "value": 40, "unit": "rem" },
      "$description": "About 75 characters of body text at the default size."
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$value": { "value": 0.5, "unit": "rem" } },
    "lg": { "$value": { "value": 0.75, "unit": "rem" } },
    "xl": { "$value": { "value": 1.25, "unit": "rem" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.55 }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "System UI fonts: no download cost and familiar on every platform."
      },
      "mono": { "$value": ["ui-monospace", "Cascadia Code", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.8125, "unit": "rem" } },
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } },
      "xl": { "$value": { "value": 1.375, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.75, "unit": "rem" } },
      "3xl": { "$value": { "value": 2.25, "unit": "rem" } },
      "4xl": { "$value": { "value": 2.75, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.6 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": { "$value": { "value": 0, "unit": "rem" } },
      "tight": { "$value": { "value": -0.03, "unit": "rem" } },
      "wide": { "$value": { "value": 0.04, "unit": "rem" } }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Shadow scale. The *-strong variants carry enough opacity to read on dark surfaces.",
    "low": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "medium": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": -2, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": -2, "unit": "px" } }
      ]
    },
    "high": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.16 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 16, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": -6, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.1059], "alpha": 0.08 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": -4, "unit": "px" } }
      ]
    },
    "low-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.45 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    },
    "medium-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 6, "unit": "px" }, "blur": { "value": 14, "unit": "px" }, "spread": { "value": -2, "unit": "px" } }
    },
    "high-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 20, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": -6, "unit": "px" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 320, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$value": [0, 0, 0, 1] }
  }
}
