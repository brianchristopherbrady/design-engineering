{
  "$description": "Reference tokens: raw scales and palettes with no intent attached. Components never read these colors directly.",
  "color": {
    "$type": "color",
    "neutral": {
      "$description": "Cool white-to-space ramp: station-white surfaces, hairline borders, monolith black.",
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9765, 0.9804], "hex": "#f8f9fa" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9412, 0.949], "hex": "#eef0f2" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.8824, 0.8941, 0.9098], "hex": "#e1e4e8" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.7843, 0.8039, 0.8275], "hex": "#c8cdd3" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.6078, 0.6314, 0.6667], "hex": "#9ba1aa" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.4196, 0.4431, 0.4824], "hex": "#6b717b" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.3137, 0.3373, 0.3725], "hex": "#50565f" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.2039, 0.2157, 0.2392], "hex": "#34373d" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.1333, 0.1412, 0.1569], "hex": "#222428" } },
      "850": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.0824, 0.0941], "hex": "#141518" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.0471, 0.0549], "hex": "#0b0c0e" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "hex": "#060708" } }
    },
    "green": {
      "$description": "Success hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9294, 0.9843, 0.9529], "hex": "#edfbf3" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.4902, 0.851, 0.6588], "hex": "#7dd9a8" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.1843, 0.651, 0.4157], "hex": "#2fa66a" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.5412, 0.3216], "hex": "#1e8a52" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0941, 0.4392, 0.2627], "hex": "#187043" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0824, 0.3529, 0.2196], "hex": "#155a38" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.1647, 0.1059], "hex": "#0a2a1b" } }
    },
    "red": {
      "$description": "Signal red: the current-location indicator and the danger hue.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9922, 0.949, 0.949], "hex": "#fdf2f2" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.8784, 0.8745], "hex": "#fbe0df" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.7412, 0.7333], "hex": "#f7bdbb" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [1, 0.5608, 0.5255], "hex": "#ff8f86" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [1, 0.3529, 0.3098], "hex": "#ff5a4f" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.9333, 0.1922, 0.1412], "hex": "#ee3124" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.8235, 0.102, 0.102], "hex": "#d21a1a" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.6902, 0.0706, 0.0941], "hex": "#b01218" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.549, 0.0549, 0.0745], "hex": "#8c0e13" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.4118, 0.0431, 0.0588], "hex": "#690b0f" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.0235, 0.0275], "hex": "#2a0607" } }
    },
    "amber": {
      "$description": "Warning hue; its lightest steps also warm the Overview sunrise.",
      "50": { "$value": { "colorSpace": "srgb", "components": [1, 0.9725, 0.902], "hex": "#fff8e6" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.9333, 0.7608], "hex": "#ffeec2" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.9725, 0.7725, 0.3529], "hex": "#f8c55a" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.8314, 0.5412, 0.0627], "hex": "#d48a10" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.7098, 0.4275, 0.0275], "hex": "#b56d07" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.4549, 0.2667, 0.0471], "hex": "#74440c" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.1137, 0.0196], "hex": "#331d05" } }
    },
    "cyan": {
      "$description": "Informational hue: the cool glow of a flight-deck display.",
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9216, 0.9804, 0.9922], "hex": "#ebfafd" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.4039, 0.8118, 0.902], "hex": "#67cfe6" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.7059, 0.8157], "hex": "#33b4d0" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.0549, 0.4824, 0.5765], "hex": "#0e7b93" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.051, 0.3922, 0.4706], "hex": "#0d6478" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.3176, 0.3804], "hex": "#0f5161" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0275, 0.1647, 0.2], "hex": "#072a33" } }
    },
    "transparent": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 },
      "$description": "Invisible fill or border that still occupies space and becomes visible in forced-colors mode."
    },
    "scrim": {
      "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9765, 0.9804], "alpha": 0.72 },
      "$description": "Translucent station white behind modal dialogs in the light theme."
    },
    "scrim-deep": {
      "$value": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.76 },
      "$description": "Translucent deep space behind modal dialogs in the dark theme."
    },
    "glow": {
      "$value": { "colorSpace": "srgb", "components": [0.9333, 0.1922, 0.1412], "alpha": 0.55 },
      "$description": "Halo around the signal indicator on dark surfaces."
    },
    "glow-soft": {
      "$value": { "colorSpace": "srgb", "components": [0.8235, 0.102, 0.102], "alpha": 0.28 },
      "$description": "Halo around the signal indicator on light surfaces."
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale. Semantic spacing tokens give these steps the names components use.",
    "2xs": { "$value": { "value": 0.25, "unit": "rem" } },
    "xs": { "$value": { "value": 0.5, "unit": "rem" } },
    "sm": { "$value": { "value": 0.75, "unit": "rem" } },
    "md": { "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$value": { "value": 1.5, "unit": "rem" } },
    "xl": { "$value": { "value": 2, "unit": "rem" } },
    "2xl": { "$value": { "value": 3, "unit": "rem" } },
    "3xl": { "$value": { "value": 4, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Control heights. md is 44px at the default text size.",
      "sm": { "$value": { "value": 2, "unit": "rem" } },
      "md": { "$value": { "value": 2.75, "unit": "rem" } },
      "lg": { "$value": { "value": 3.25, "unit": "rem" } }
    },
    "badge": {
      "sm": { "$value": { "value": 1.25, "unit": "rem" } },
      "md": { "$value": { "value": 1.5, "unit": "rem" } },
      "lg": { "$value": { "value": 2, "unit": "rem" } }
    },
    "icon": {
      "sm": { "$value": { "value": 1, "unit": "rem" } },
      "md": { "$value": { "value": 1.25, "unit": "rem" } },
      "lg": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "item": {
      "$description": "Minimum track sizes for intrinsic Grid layouts.",
      "xs": { "$value": { "value": 10, "unit": "rem" } },
      "sm": { "$value": { "value": 14, "unit": "rem" } },
      "md": { "$value": { "value": 18, "unit": "rem" } },
      "lg": { "$value": { "value": 24, "unit": "rem" } }
    },
    "dialog": {
      "$description": "Maximum dialog widths; dialogs never exceed the viewport.",
      "sm": { "$value": { "value": 24, "unit": "rem" } },
      "md": { "$value": { "value": 32, "unit": "rem" } },
      "lg": { "$value": { "value": 44, "unit": "rem" } }
    },
    "container": {
      "$description": "Maximum inline sizes for Container.",
      "narrow": { "$value": { "value": 48, "unit": "rem" } },
      "default": { "$value": { "value": 72, "unit": "rem" } },
      "wide": { "$value": { "value": 90, "unit": "rem" } }
    },
    "measure": {
      "$value": { "value": 40, "unit": "rem" },
      "$description": "About 75 characters of body text at the default size."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Machined corners: just enough radius to soften an edge, never enough to look inflated.",
    "sm": { "$value": { "value": 0.125, "unit": "rem" } },
    "md": { "$value": { "value": 0.25, "unit": "rem" } },
    "lg": { "$value": { "value": 0.375, "unit": "rem" } },
    "xl": { "$value": { "value": 0.75, "unit": "rem" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.55 }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Jost Variable", "Jost", "Futura", "Century Gothic", "Avenir Next", "system-ui", "sans-serif"],
        "$description": "Jost, a geometric sans in the Futura tradition, self-hosted as one variable file. Futura and Century Gothic are local fallbacks."
      },
      "mono": { "$value": ["ui-monospace", "Cascadia Code", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1.0625, "unit": "rem" }, "$description": "Body text. Jost's compact x-height reads best one step above 16px." },
      "lg": { "$value": { "value": 1.25, "unit": "rem" } },
      "xl": { "$value": { "value": 1.5, "unit": "rem" } },
      "2xl": { "$value": { "value": 2, "unit": "rem" } },
      "3xl": { "$value": { "value": 2.75, "unit": "rem" } },
      "4xl": { "$value": { "value": 3.75, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.12 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.65 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": { "$value": { "value": 0, "unit": "rem" } },
      "tight": { "$value": { "value": -0.02, "unit": "rem" } },
      "wide": { "$value": { "value": 0.08, "unit": "rem" } },
      "wider": { "$value": { "value": 0.16, "unit": "rem" }, "$description": "Uppercase readouts: captions, eyebrows and navigation." }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Diffuse, even light with long soft falloff. The *-strong variants carry enough opacity to read on dark surfaces.",
    "low": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.05 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": -6, "unit": "px" } }
      ]
    },
    "medium": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.14 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": -10, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 10, "unit": "px" }, "spread": { "value": -4, "unit": "px" } }
      ]
    },
    "high": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.24 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 40, "unit": "px" }, "blur": { "value": 80, "unit": "px" }, "spread": { "value": -24, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0235, 0.0275, 0.0314], "alpha": 0.1 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": -12, "unit": "px" } }
      ]
    },
    "low-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    },
    "medium-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.7 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 16, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": -12, "unit": "px" } }
    },
    "high-strong": {
      "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.85 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 40, "unit": "px" }, "blur": { "value": 90, "unit": "px" }, "spread": { "value": -20, "unit": "px" } }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Unhurried timing: nothing in a weightless room snaps.",
    "fast": { "$value": { "value": 160, "unit": "ms" } },
    "base": { "$value": { "value": 280, "unit": "ms" } },
    "slow": { "$value": { "value": 560, "unit": "ms" } },
    "slower": { "$value": { "value": 1400, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.4, 0, 0.2, 1] },
    "decelerate": { "$value": [0.16, 1, 0.3, 1], "$description": "A long, frictionless glide to rest." }
  }
}
