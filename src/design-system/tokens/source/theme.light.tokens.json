{
  "$description": "Light theme: maps semantic color and elevation roles to reference tokens.",
  "surface": {
    "$type": "color",
    "canvas": { "$value": "{color.neutral.50}", "$description": "Page background." },
    "panel": { "$value": "{color.neutral.0}", "$description": "Cards, dialogs, inputs and other raised content." },
    "sunken": { "$value": "{color.neutral.100}", "$description": "Code blocks, previews and inset areas." },
    "accent": { "$value": "{color.blue.50}", "$description": "Selected or current items." }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": "{color.neutral.900}" },
    "muted": { "$value": "{color.neutral.600}", "$description": "Secondary text. Meets 4.5:1 on every surface." },
    "link": { "$value": "{color.blue.700}" }
  },
  "border": {
    "$type": "color",
    "subtle": { "$value": "{color.neutral.200}", "$description": "Decorative separation; not enough contrast to identify a control." },
    "default": { "$value": "{color.neutral.300}" },
    "strong": { "$value": "{color.neutral.500}", "$description": "Control boundaries. Meets 3:1 against surfaces." }
  },
  "action": {
    "$type": "color",
    "primary": {
      "background": { "$value": "{color.blue.600}" },
      "hover": { "$value": "{color.blue.700}" },
      "active": { "$value": "{color.blue.800}" },
      "foreground": { "$value": "{color.neutral.0}" },
      "border": { "$value": "{color.blue.700}" }
    },
    "secondary": {
      "background": { "$value": "{color.neutral.0}" },
      "hover": { "$value": "{color.neutral.100}" },
      "active": { "$value": "{color.neutral.200}" },
      "foreground": { "$value": "{color.neutral.900}" },
      "border": { "$value": "{color.neutral.500}" }
    },
    "ghost": {
      "background": { "$value": "{color.transparent}" },
      "hover": { "$value": "{color.blue.50}" },
      "active": { "$value": "{color.blue.100}" },
      "foreground": { "$value": "{color.blue.700}" },
      "border": { "$value": "{color.transparent}" }
    },
    "danger": {
      "background": { "$value": "{color.red.700}" },
      "hover": { "$value": "{color.red.800}" },
      "active": { "$value": "{color.red.900}" },
      "foreground": { "$value": "{color.neutral.0}" },
      "border": { "$value": "{color.red.800}" }
    },
    "disabled": {
      "background": { "$value": "{color.neutral.100}" },
      "foreground": { "$value": "{color.neutral.500}" },
      "border": { "$value": "{color.neutral.200}" }
    }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{color.blue.600}", "$description": "Keyboard focus outline. Meets 3:1 against every surface." }
  },
  "tone": {
    "$type": "color",
    "$description": "Status and emphasis families. text and surface pair for subtle treatments; on-solid and solid pair for filled ones.",
    "neutral": {
      "text": { "$value": "{color.neutral.700}" },
      "surface": { "$value": "{color.neutral.100}" },
      "border": { "$value": "{color.neutral.500}" },
      "solid": { "$value": "{color.neutral.700}" },
      "on-solid": { "$value": "{color.neutral.0}" }
    },
    "brand": {
      "text": { "$value": "{color.blue.700}" },
      "surface": { "$value": "{color.blue.50}" },
      "border": { "$value": "{color.blue.500}" },
      "solid": { "$value": "{color.blue.600}" },
      "on-solid": { "$value": "{color.neutral.0}" }
    },
    "success": {
      "text": { "$value": "{color.green.800}" },
      "surface": { "$value": "{color.green.50}" },
      "border": { "$value": "{color.green.600}" },
      "solid": { "$value": "{color.green.700}" },
      "on-solid": { "$value": "{color.neutral.0}" }
    },
    "warning": {
      "text": { "$value": "{color.amber.800}" },
      "surface": { "$value": "{color.amber.50}" },
      "border": { "$value": "{color.amber.600}" },
      "solid": { "$value": "{color.amber.300}" },
      "on-solid": { "$value": "{color.neutral.950}" }
    },
    "danger": {
      "text": { "$value": "{color.red.700}" },
      "surface": { "$value": "{color.red.50}" },
      "border": { "$value": "{color.red.600}" },
      "solid": { "$value": "{color.red.700}" },
      "on-solid": { "$value": "{color.neutral.0}" }
    },
    "info": {
      "text": { "$value": "{color.cyan.800}" },
      "surface": { "$value": "{color.cyan.50}" },
      "border": { "$value": "{color.cyan.600}" },
      "solid": { "$value": "{color.cyan.700}" },
      "on-solid": { "$value": "{color.neutral.0}" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "low": { "$value": "{shadow.low}", "$description": "Resting cards." },
    "medium": { "$value": "{shadow.medium}", "$description": "Hovered or lifted surfaces." },
    "high": { "$value": "{shadow.high}", "$description": "Dialogs and other overlays." }
  },
  "overlay": {
    "backdrop": { "$type": "color", "$value": "{color.scrim}", "$description": "Behind modal dialogs." }
  }
}
